# Finnhub API key (free tier). Get one at https://finnhub.io/register
FINNHUB_API_KEY=

# Supabase project settings. Found in Project Settings > API in the
# Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key -- server-side only, never exposed to the client.
# Same Project Settings > API page, "service_role" secret.
SUPABASE_SERVICE_ROLE_KEY=

# Global daily cap on Market-Read-style Anthropic generations (per-ticker
# briefing bullets + directional lean), shared across the whole app.
# Optional -- defaults to 20 when unset.
MARKET_READ_DAILY_CAP=
